# Токен бота от @BotFather
BOT_TOKEN=

# Путь к файлу SQLite (по умолчанию bot.db)
DB_PATH=bot.db

# Таймзона по умолчанию для новых пользователей
TZ=Europe/Moscow

# HTTP-прокси ТОЛЬКО для запросов к rasp.rea.ru.
# Нужен, если IP сервера блокируется анти-бот заглушкой "не робот".
# Пусто = ходить напрямую. Пример: http://127.0.0.1:10809
REA_PROXY=
