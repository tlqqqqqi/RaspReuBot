# Токен бота от @BotFather
BOT_TOKEN=

# Путь к файлу SQLite (по умолчанию bot.db)
DB_PATH=bot.db

# Таймзона по умолчанию для новых пользователей
TZ=Europe/Moscow

# HTTP-прокси для запросов к ИСТОЧНИКАМ расписания (pleh.tech И rasp.rea.ru).
# Оба режут датацентровые IP: pleh.tech отдаёт 403, rasp.rea.ru — анти-бот
# заглушку. Нужен прокси с RU-выходом: внешний HTTP-прокси с логином в URL
# или локальный Xray-инбаунд. Только http:// — socks5:// aiohttp не умеет.
# Пусто = ходить напрямую. Примеры: http://user:pass@host:port, http://127.0.0.1:10809
SITE_PROXY=

# Устаревший алиас SITE_PROXY (только rasp.rea.ru по смыслу, но применяется к
# обоим источникам). Оставлен для обратной совместимости; предпочитай SITE_PROXY.
REA_PROXY=
